# API / provider environment template
# Runtime .env uses 1Password op:// references; never put real keys in files.
AI_PROVIDER=your_provider_here
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=your_minimax_model_here
MINIMAX_BASE_URL=your_minimax_base_url_here
CCSWITCH_API_KEY=your_ccswitch_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=your_deepseek_base_url_here
DEEPSEEK_MODEL=your_deepseek_model_here
CCSWITCH_MODEL=your_ccswitch_model_here
CCSWITCH_BASE_URL=your_ccswitch_base_url_here
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here

# Routing: rules (default) | jev | llm; resolve credentials with op run
FOOD_ROUTER=rules
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_KEY="op://API keys/TypeSafe API/credential"
FOOD_SEARCH_DEPTH=basic

# Supabase backend (see PLAN.md). Keep real values in 1Password; .env holds op:// references only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
