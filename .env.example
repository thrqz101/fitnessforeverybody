# Environment template. Copy to .env and fill each secret with a 1Password reference of the form
# op://<vault>/<item>/<field>; `npm run dev` resolves them through `op run`. Never put a real key in
# any file, and never commit .env. See .docs/setup.md.

# --- Food recognition: LLM provider (server-only secrets) ---
# AI_PROVIDER selects one of: minimax (default) | deepseek | ccswitch | dashscope.
AI_PROVIDER=
MINIMAX_API_KEY=
MINIMAX_MODEL=
MINIMAX_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
CCSWITCH_API_KEY=
CCSWITCH_BASE_URL=
CCSWITCH_MODEL=

# --- Food recognition: brand / packaged-food web search (server-only secrets) ---
TAVILY_API_KEY=
# basic (default) | fast
FOOD_SEARCH_DEPTH=basic

# --- Food recognition: routing (server-only) ---
# jev (default: TypeSafe Jev classifier, falls back to rules) | rules (no network) | llm
FOOD_ROUTER=jev
TYPESAFE_MODEL=jev-latest
TYPESAFE_API_KEY=

# --- Supabase ---
# NEXT_PUBLIC_* values are shipped to the browser: they must only ever hold public values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret. Bypasses RLS; never expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
